
:root {
    --bg-primary: #0b0e13;
    --bg-secondary: #151a22;
    --accent-primary: #e10600;
    --text-primary: #ffffff;
    --text-secondary: #a7b0bd;
}

.main-container {
    flex-grow: 1;
    background-color: var(--bg-primary);
    color: var(--text-primary);
}

.top-bar {
    height: 76px;
    flex-direction: row;
    align-items: center;
    padding-left: 36px;
    padding-right: 36px;
    background-color: #11161e;
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-primary);
}

.logo, .logo-accent {
    font-size: 23px;
    -unity-font-style: bold;
}

.logo-accent {
    color: var(--accent-primary);
    margin-left: 7px;
}

.top-spacer {
    flex-grow: 1;
}

.top-label, .bottom-text, .season-label {
    font-size: 12px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.hero {
    flex-grow: 1;
    justify-content: center;
    padding-left: 9%;
}

.eyebrow {
    color: var(--accent-primary);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 18px;
}

.hero-title {
    font-size: 48px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.accent-text {
    color: var(--accent-primary);
}

.subtitle {
    color: var(--text-secondary);
    font-size: 17px;
    margin-top: 20px;
    margin-bottom: 30px;
}

.button-row {
    flex-direction: row;
    align-items: center;
}

.primary-button, .secondary-button {
    height: 52px;
    padding-left: 25px;
    padding-right: 25px;
    -unity-font-style: bold;
    font-size: 14px;
    border-radius: 3px;
    margin-right: 12px;
    transition-duration: 0.2s;
}

.primary-button {
    background-color: var(--accent-primary);
    color: white;
    border-width: 0;
}

.primary-button:hover {
    background-color: #ff241c;
}

.secondary-button {
    background-color: #1b222d;
    color: white;
    border-width: 1px;
    border-color: #394352;
}

.secondary-button:hover {
    background-color: #303947;
}

.bottom-bar {
    height: 55px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 36px;
    padding-right: 36px;
    border-top-width: 1px;
    border-top-color: #252c37;
}
